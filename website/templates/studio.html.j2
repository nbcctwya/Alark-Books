<!DOCTYPE html><html lang="{{ book.language | default('zh-CN') }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ book.title }}</title><meta name="author" content="{{ book.author }}"><link rel="stylesheet" href="styles/book.css"><link rel="stylesheet" href="styles/profile.css"><link rel="stylesheet" href="styles/{{ book.design }}.css"><link rel="stylesheet" href="styles/{{ book.design }}-screen.css" media="screen"></head>
<body class="{{ book.design }} {{ profile_name }}">
<section class="cover"><div class="studio-masthead"><span>{{ brand.name }}</span><span>{{ book.series }}</span></div><div class="studio-volume">{{ book.volume }}</div><div class="studio-title"><p class="studio-kicker">{{ 'A BUSINESS FIELD MANUAL' if book.design == 'business' else 'AN INVESTMENT NOTEBOOK' }}</p><h1>{% for line in book.cover_title_lines | default([book.title]) %}<span>{{ line }}</span>{% endfor %}</h1><p class="studio-subtitle">{{ book.subtitle }}</p><p class="studio-author">{{ book.author }} 著</p></div>{% if book.cover_asset %}<img class="studio-art" src="{{ book.cover_asset }}" alt="{{ book.cover_alt }}">{% endif %}<div class="studio-footer"><span>{{ brand.imprint }}</span><span>{{ book.date }} / {{ 'BLUEPRINT' if book.design == 'business' else 'FIELD NOTES' }}</span></div></section>
<section class="colophon"><p class="eyebrow">{{ book.series }}</p><h1>{{ book.title }}</h1><p class="lead">{{ book.description }}</p><dl><dt>作者</dt><dd>{{ book.author }}</dd><dt>版本</dt><dd>{{ book.edition }} · {{ book.date }}</dd><dt>出品</dt><dd>{{ brand.name }} · {{ brand.imprint }}</dd><dt>编号</dt><dd>{{ book.identifier }}</dd></dl><p class="rights">{{ book.rights }}</p><p class="rights">{{ book.cover_credit }}</p><p class="edition-note">{{ book.note }}</p></section>
<nav class="contents" aria-label="目录"><p class="eyebrow">{{ 'STRUCTURE / 结构导航' if book.design == 'business' else 'CONTENTS / 阅读索引' }}</p><h1>{{ '一门生意，多处连接。' if book.design == 'business' else '在时间里，留下判断。' }}</h1><ol>{% for chapter in chapters %}<li><a href="#{{ chapter.id }}"><span class="toc-number">{{ chapter.number }}</span><span>{{ chapter.title }}</span></a><p class="toc-subtitle">{{ chapter.kicker }}</p></li>{% endfor %}</ol></nav>
{% for chapter in chapters %}<section class="chapter reading-{{ chapter.layout }}" id="{{ chapter.id }}"><header class="chapter-heading"><p class="chapter-number">{{ chapter.number }}</p><p class="eyebrow">{{ chapter.kicker }}</p><h1>{{ chapter.title }}</h1><p class="chapter-subtitle">{{ chapter.subtitle }}</p></header>{% if chapter.statement %}<aside class="chapter-brief"><span>{{ '本章问题' if book.design == 'business' else '阅读坐标' }}</span><p>{{ chapter.statement }}</p></aside>{% endif %}<div class="prose">{{ chapter.html | safe }}</div></section>{% endfor %}
<section class="endpage"><p class="eyebrow">{{ book.series }}</p><p class="end-title">{{ '把结构，带回下一次经营。' if book.design == 'business' else '时间继续，记录也继续。' }}</p><p>{{ book.author }}</p><p class="end-imprint">{{ brand.name }} · {{ brand.imprint }}</p></section></body></html>
