<!doctype html>
<html lang="{{ book.language | default('zh-CN') }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ book.title }}</title><meta name="author" content="{{ book.author }}"><link rel="stylesheet" href="styles/book.css"><link rel="stylesheet" href="styles/profile.css"><link rel="stylesheet" href="styles/folio.css"><link rel="stylesheet" href="styles/folio-screen.css" media="screen"></head>
<body class="folio {{ profile_name }}">
<section class="folio-cover" aria-label="封面"><div class="folio-cover-type"><p class="eyebrow">{{ book.series | default('ALARK FOLIO') }} / {{ book.volume | default('01') }}</p><h1>{{ book.title }}</h1><p>{{ book.subtitle }}</p></div>{% if book.cover_asset %}<img src="{{ book.cover_asset }}" alt="{{ book.cover_alt | default(book.title) }}">{% endif %}<div class="folio-cover-foot"><span>{{ book.author }} · 影像编选</span><span>{{ book.date }} / {{ brand.imprint }}</span></div></section>
<section class="folio-about"><p class="eyebrow">ABOUT THIS EDITION</p><h1>{{ book.title }}</h1><p>{{ book.description }}</p><dl><dt>编著</dt><dd>{{ book.author }}</dd><dt>书系</dt><dd>{{ book.series }}</dd><dt>版本</dt><dd>{{ book.edition }} · {{ book.date }}</dd><dt>编号</dt><dd>{{ book.identifier }}</dd></dl><p class="folio-small">{{ book.note }}</p><p class="folio-small">{{ book.cover_credit }}</p><p class="folio-small">{{ book.rights }}</p></section>
<nav class="folio-contents" aria-label="目录"><p class="eyebrow">SEQUENCE / 观看的次序</p><h1>图像之间</h1><ol>{% for chapter in chapters %}<li><a href="#{{ chapter.id }}"><span>{{ chapter.number }}</span> {{ chapter.title }}</a></li>{% endfor %}</ol></nav>
{% for chapter in chapters %}<section class="folio-chapter folio-layout-{{ chapter.photo_layout }}" id="{{ chapter.id }}"><header class="folio-heading"><p class="eyebrow">{{ chapter.number }} / {{ chapter.kicker }}</p><h1>{{ chapter.title }}</h1>{% if chapter.subtitle %}<p class="folio-subtitle">{{ chapter.subtitle }}</p>{% endif %}</header><div class="folio-prose">{{ chapter.html | safe }}</div></section>{% endfor %}
<section class="folio-end"><p class="eyebrow">END OF SEQUENCE</p><h1>{{ book.title }}</h1><p>{{ book.author }} / {{ book.series }}</p><p class="folio-small">{{ book.edition }}</p></section>
</body></html>
