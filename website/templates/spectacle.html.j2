<!DOCTYPE html><html lang="{{ book.language | default('zh-CN') }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ book.title }}</title><meta name="author" content="{{ book.author }}"><link rel="stylesheet" href="styles/book.css"><link rel="stylesheet" href="styles/profile.css"><link rel="stylesheet" href="styles/spectacle.css"><link rel="stylesheet" href="styles/spectacle-screen.css" media="screen"></head>
<body class="spectacle {{ profile_name }}">
<section class="cover"><div class="campaign-masthead"><span>{{ brand.name }}</span><span>{{ book.series }} / {{ book.volume }}</span></div><div class="campaign-title"><p>THE ART OF BEING DESIRED</p><h1>{% for line in book.cover_title_lines | default([book.title]) %}<span>{{ line }}</span>{% endfor %}</h1><p class="campaign-subtitle">{{ book.subtitle }}</p></div>{% if book.cover_asset %}<img class="campaign-image" src="{{ book.cover_asset }}" alt="{{ book.cover_alt }}">{% endif %}<p class="campaign-word">DESIRE.</p><p class="campaign-author">{{ book.author }} 著</p><div class="campaign-band">被看见，只是开始。 / MAKE THEM LOOK.</div></section>
<section class="manifesto"><p class="micro">MANIFESTO / 00</p><h1>{% for line in book.manifesto_lines | default([book.title]) %}<span>{{ line }}</span>{% endfor %}</h1><p class="manifesto-caption">{{ book.manifesto_caption | default('') }}</p><p class="manifesto-imprint">{{ brand.name }} · {{ brand.imprint }}</p></section>
<section class="colophon"><p class="eyebrow">THE MAKING OF DESIRE</p><h1>{{ book.title }}</h1><p class="lead">{{ book.description }}</p><dl><dt>作者</dt><dd>{{ book.author }}</dd><dt>系列</dt><dd>{{ book.series }}</dd><dt>版本</dt><dd>{{ book.edition }} · {{ book.date }}</dd><dt>编号</dt><dd>{{ book.identifier }}</dd></dl><p class="rights">{{ book.rights }}</p><p class="rights">{{ book.cover_credit }}</p><p class="edition-note">{{ book.note }}</p></section>
<nav class="contents" aria-label="目录"><p class="eyebrow">THE PLAYBOOK</p><h1>从第一眼，<br>到被记住。</h1><ol>{% for chapter in chapters %}<li><a href="#{{ chapter.id }}"><span class="toc-number">{{ chapter.number }}</span><span>{{ chapter.title }}</span></a></li>{% endfor %}</ol></nav>
{% for chapter in chapters %}<section class="campaign-opener opener-{{ loop.index % 2 }}" id="{{ chapter.id }}"><div class="opener-top"><span>{{ book.series }}</span><span>{{ chapter.number }} / {{ '%02d'|format(chapters|length) }}</span></div><p class="opener-index">{{ chapter.number }}</p><div class="opener-title"><p>{{ chapter.kicker }}</p><h1>{{ chapter.title }}</h1><p class="opener-subtitle">{{ chapter.subtitle }}</p></div><p class="opener-statement">{{ chapter.statement }}</p><p class="opener-bottom">{{ brand.name }} / THE DESIRE ISSUE</p></section><section class="campaign-reading reading-{{ chapter.layout }}"><header class="reading-header"><span>{{ chapter.number }} / {{ chapter.kicker }}</span><span>{{ chapter.title }}</span></header><div class="prose">{{ chapter.html | safe }}</div></section>{% endfor %}
<section class="manifesto finale"><p class="micro">THE LAST WORD</p><h1>{% for line in book.end_lines | default([book.title]) %}<span>{{ line }}</span>{% endfor %}</h1><p class="manifesto-caption">{{ brand.name }} / {{ brand.imprint }}</p><p class="manifesto-imprint">END OF ISSUE / {{ book.volume }}</p></section></body></html>
