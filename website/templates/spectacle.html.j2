<!doctype html>
<html lang="{{ book.language | default('zh-CN') }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ book.title }}</title><meta name="author" content="{{ book.author }}">
<link rel="stylesheet" href="styles/book.css"><link rel="stylesheet" href="styles/profile.css">
<link rel="stylesheet" href="styles/spectacle.css"><link rel="stylesheet" href="styles/spectacle-screen.css" media="screen">
</head>
<body class="spectacle {{ profile_name }}">
<section class="cover" aria-label="封面">
  <div class="campaign-masthead"><span>{{ brand.name }} / {{ book.series | default('SPECTACLE') }}</span><span>No. {{ book.volume | default('01') }}</span></div>
  <p class="campaign-word">DESIRE</p>
  {% if book.cover_asset %}<img class="campaign-image" src="{{ book.cover_asset }}" alt="{{ book.cover_alt | default(book.title) }}">{% endif %}
  <div class="campaign-title"><h1>{% for line in book.cover_title_lines | default([book.title]) %}<span>{{ line }}</span>{% endfor %}</h1><p class="campaign-subtitle">{{ book.subtitle }}</p></div>
  <div class="campaign-footer"><span>{{ book.author }} 著</span><span>THE ART OF BEING DESIRED</span></div>
</section>
<section class="manifesto">
  <p class="micro">OPENING NOTE / {{ book.volume | default('01') }}</p>
  <h1>{% for line in book.manifesto_lines | default([book.title]) %}<span>{{ line }}</span>{% endfor %}</h1>
  <p class="manifesto-caption">{{ book.manifesto_caption | default('') }}</p>
  <p class="manifesto-imprint">{{ brand.name }} · {{ brand.imprint }}</p>
</section>
<section class="colophon"><p class="eyebrow">ABOUT THIS ISSUE</p><h1>{{ book.title }}</h1><p class="lead">{{ book.description }}</p><dl><dt>作者</dt><dd>{{ book.author }}</dd><dt>系列</dt><dd>{{ book.series }}</dd><dt>版本</dt><dd>{{ book.edition }} · {{ book.date }}</dd><dt>编号</dt><dd>{{ book.identifier }}</dd></dl><p class="rights">{{ book.rights }}</p><p class="rights">{{ book.cover_credit }}</p><p class="edition-note">{{ book.note }}</p></section>
<nav class="contents" aria-label="目录">
  <p class="eyebrow">IN THIS ISSUE</p><h1>目次<span>Contents</span></h1>
  <ol>{% for chapter in chapters %}<li><a href="#{{ chapter.id }}"><span class="toc-number">{{ chapter.number }}</span><span>{{ chapter.title }}</span></a>{% if chapter.kicker %}<p class="contents-kicker">{{ chapter.kicker }}</p>{% endif %}</li>{% endfor %}</ol>
</nav>
{% for chapter in chapters %}
<section class="campaign-reading reading-{{ chapter.layout }}" id="{{ chapter.id }}">
  <header class="campaign-opener">
    <div class="opener-top"><span>{{ chapter.kicker }}</span><span>{{ book.series }}</span></div>
    <div class="opener-heading"><p class="opener-index">{{ chapter.number }}</p><div class="opener-title"><h1{% if chapter.title|length > 7 %} class="title-long"{% endif %}>{{ chapter.title }}</h1>{% if chapter.subtitle and chapter.subtitle != chapter.statement %}<p class="opener-subtitle">{{ chapter.subtitle }}</p>{% endif %}</div></div>
    {% if chapter.statement %}<p class="opener-statement">{{ chapter.statement }}</p>{% endif %}
  </header>
  <div class="prose">{{ chapter.html | safe }}</div>
</section>
{% endfor %}
<section class="manifesto finale"><p class="micro">CLOSING NOTE</p><h1>{% for line in book.end_lines | default([book.title]) %}<span>{{ line }}</span>{% endfor %}</h1><p class="manifesto-caption">{{ brand.name }} / {{ brand.imprint }}</p><p class="manifesto-imprint">END OF ISSUE / {{ book.volume }}</p></section>
</body></html>
