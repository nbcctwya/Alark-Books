<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ brand.name }} · 出版物</title><style>
@font-face{font-family:Ark;src:url('../design/fonts/NotoSerifSC-Regular.ttf')}*{box-sizing:border-box}body{margin:0;background:#fdfcf8;color:#292722;font-family:Ark,serif}main{max-width:1120px;margin:auto;padding:48px 56px}header{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid #292722;padding-bottom:20px}.wordmark{font-size:32px;letter-spacing:1px}.label{font:10px system-ui;letter-spacing:2px;color:#726e65}.intro{padding:58px 0 50px;display:flex;align-items:end;justify-content:space-between;gap:40px}h1{font-size:44px;letter-spacing:6px;font-weight:400;line-height:1.5;margin:8px 0}.intro p{font-size:13px;line-height:1.9;color:#726e65}.shelf{display:grid;grid-template-columns:1fr 1fr;gap:70px}.book-number{display:flex;justify-content:space-between;margin-bottom:25px;font:10px system-ui;letter-spacing:1px;color:#726e65}.cover-wrap{display:block;text-align:center;border-bottom:1px solid #c7c1b5;padding-bottom:30px}.cover-wrap img{height:380px;max-width:100%;object-fit:contain;filter:drop-shadow(3px 5px 5px #29272213)}.book h2{font-size:27px;font-weight:400;margin:25px 0 10px}.book p{font-size:13px;color:#726e65;line-height:1.8}a{color:inherit;text-decoration:none}a:focus-visible{outline:2px solid #726e65;outline-offset:4px}.links{display:flex;gap:16px;flex-wrap:wrap;margin-top:22px}.links a{border-bottom:1px solid #c7c1b5;padding-bottom:4px;font-size:12px}.links a:hover{border-color:#292722}.footer{border-top:1px solid #292722;margin-top:68px;padding:22px 0;display:flex;justify-content:space-between;font-size:11px;color:#726e65}@media(max-width:650px){main{padding:24px}.shelf{grid-template-columns:1fr;gap:50px}.intro{display:block;padding-top:38px}h1{font-size:34px}.cover-wrap img{height:340px}.footer{gap:20px;flex-wrap:wrap}.label{font-size:8px}}
</style></head><body><main><header><a class="wordmark" href="index.html">{{ brand.name }}</a><span class="label">{{ brand.imprint }} / PUBLICATIONS</span></header><div class="intro"><div><span class="label">独立写作 · 思想与实践</span><h1>出版物</h1></div><p>{{ brand.tagline }}<br>文章、图像，与值得保存的思考。</p></div><p><a href="longform-review/index.html">长篇样书 · 正文与图文排版审阅 ↗</a></p><section class="shelf" aria-label="已生成的书籍">{% for book in books %}<article class="book"><div class="book-number"><span>{{ book.series }}</span><span>{{ book.volume }}</span></div><a class="cover-wrap" href="{{ book.primary }}" aria-label="阅读{{ book.title }}"><img src="{{ book.slug }}/cover.png" alt="{{ book.title }}封面"></a><h2>{{ book.title }}</h2><p>{{ book.subtitle }}</p><div class="links">{% for link in book.links %}<a href="{{ link.href }}">{{ link.label }}</a>{% endfor %}</div></article>{% else %}<p>第一本书，正在写作中。</p>{% endfor %}</section><footer class="footer"><span>{{ brand.name }} / {{ brand.alternate }}</span><a href="../design/five-designs.html">六款设计对照 ↗</a></footer></main></body></html>
